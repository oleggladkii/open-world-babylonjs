{
  "name": "open-world-babylon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@babylonjs/core": "^8.4.1",
    "@babylonjs/gui": "^8.4.1",
    "@babylonjs/gui-editor": "^8.7.0",
    "@babylonjs/inspector": "^8.7.0",
    "@babylonjs/loaders": "^8.4.1",
    "@babylonjs/materials": "^8.4.1",
    "@babylonjs/procedural-textures": "^8.8.5",
    "@babylonjs/serializers": "^8.7.0",
    "@sentry/tracing": "^7.13.0",
    "@sentry/vue": "^7.13.0",
    "@vuelidate/core": "^2.0.0-alpha.44",
    "@vuelidate/validators": "^2.0.0-alpha.31",
    "@vueuse/core": "^13.2.0",
    "axios": "^0.24.0",
    "core-js": "^3.8.3",
    "dayjs": "^1.11.4",
    "gsap": "^3.13.0",
    "pinia": "^2.0.22",
    "pinia-plugin-persistedstate": "^2.2.0",
    "pinia-shared-state": "^0.2.8",
    "register-service-worker": "^1.7.2",
    "vue": "^3.2.13",
    "vue-router": "^4.0.3"
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^1.20.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^9.17.0",
    "eslint-plugin-vue-pug": "^0.5.4",
    "jsdom": "^22.1.0",
    "lint-staged": "^14.0.0",
    "prettier": "^3.0.0",
    "pug": "^3.0.2",
    "sass": "^1.77.0",
    "typescript": "^5.0.0",
    "vite": "^4.4.0",
    "vite-plugin-pwa": "^0.16.0",
    "vitest": "^0.34.0",
    "vue-eslint-parser": "^9.3.0",
    "vue-tsc": "^1.8.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "parser": "vue-eslint-parser",
    "extends": [
      "plugin:vue/vue3-recommended",
      "plugin:vue-pug/vue3-recommended",
      "eslint:recommended",
      "@vue/typescript/recommended",
      "plugin:prettier/recommended"
    ],
    "parserOptions": {
      "parser": {
        "ts": "@typescript-eslint/parser"
      },
      "vueFeatures": {
        "filter": true,
        "interpolationAsNonHTML": true,
        "styleCSSVariableInjection": true
      },
      "sourceType": "module",
      "ecmaVersion": 2020,
      "ecmaFeatures": {
        "globalReturn": false,
        "impliedStrict": false,
        "jsx": false
      }
    },
    "rules": {},
    "overrides": [
      {
        "files": [
          "**/__tests__/*.{j,t}s?(x)",
          "**/tests/unit/**/*.spec.{j,t}s?(x)"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "type": "module"
}
